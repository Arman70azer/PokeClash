[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://battle/data/ability_data.gd" id="ability"]

[resource]
script = ExtResource("ability")
id = &"normalize"
name = "Normalise"
description = "Toutes les capacités du Pokémon deviennent\\nde type Normal, quel que soit leur type original.\\nLeur puissance augmente légèrement."
