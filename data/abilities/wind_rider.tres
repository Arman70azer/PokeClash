[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://battle/data/ability_data.gd" id="ability"]

[resource]
script = ExtResource("ability")
id = &"wind_rider"
name = "Aéroporté"
description = "L'Attaque du Pokémon augmente si un vent arrière souffle\\nou s'il est touché par une capacité faisant appel au vent.\\nDans ce dernier cas, il ne subit aucun dégât."
