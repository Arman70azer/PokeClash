[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://battle/data/ability_data.gd" id="ability"]

[resource]
script = ExtResource("ability")
id = &"thick_fat"
name = "Isograisse"
description = "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu'il subit des capacités de types Feu et Glace."
