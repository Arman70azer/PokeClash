[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://battle/data/ability_data.gd" id="ability"]

[resource]
script = ExtResource("ability")
id = &"dry_skin"
name = "Peau Sèche"
description = "Quand le soleil brille, le Pokémon perd des PV et subit plus de dégâts des capacités Feu, mais il regagne des PV lorsqu'il pleut ou s'il est touché par une capacité Eau."
