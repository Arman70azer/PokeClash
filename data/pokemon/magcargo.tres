script = ExtResource("species")
id = &"magcargo"
dex_number = 219
name = "Volcaropod"
types = Array[int]([1, 12])
base_hp = 60
base_attack = 50
base_defense = 120
base_sp_attack = 90
base_sp_defense = 80
base_speed = 30
description = "La température de Volcaropod est d'environ 10 000 °C. L'eau s'évapore à son contact. Si ce Pokémon se retrouve sous la pluie, les gouttes d'eau forment de la vapeur et couvrent la zone de brouillard."
