[gd_resource type="Resource" script_class="MoveData" format=3]

[ext_resource type="Script" path="res://battle/data/move_data.gd" id="move"]
[ext_resource type="Script" path="res://battle/data/move_effect.gd" id="effect"]
[ext_resource type="Script" path="res://battle/effects/inflict_condition_effect.gd" id="inflict_condition_effect"]
[ext_resource type="Script" path="res://battle/effects/recoil_effect.gd" id="recoil_effect"]

[sub_resource type="Resource" id="e0"]
script = ExtResource("inflict_condition_effect")
condition = &"burn"
chance = 10

[sub_resource type="Resource" id="e1"]
script = ExtResource("recoil_effect")
denominator = 3

[resource]
script = ExtResource("move")
id = &"flare_blitz"
name = "Boutefeu"
type = 1
category = 0
power = 120
accuracy = 100
pp = 15
priority = 0
effects = Array[ExtResource("effect")]([SubResource("e0"), SubResource("e1")])
description = "Le lanceur s'embrase avant de charger l'ennemi. Le choc blesse aussi gravement le lanceur. Peut brûler l'ennemi."
