    <effect id="kage_out-fx" name="kage_out">
      <profile_COMMON>
        <newparam sid="kage_out-diffuse-surface">
          <surface type="2D">
            <init_from>kage_out-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="kage_out-diffuse-sampler">
          <sampler2D>
            <source>kage_out-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="kage_out-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
