    <effect id="sea_mizu1_1-fx" name="sea_mizu1_1">
      <profile_COMMON>
        <newparam sid="sea_mizu1_1-diffuse-surface">
          <surface type="2D">
            <init_from>sea_mizu1_1-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="sea_mizu1_1-diffuse-sampler">
          <sampler2D>
            <source>sea_mizu1_1-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="sea_mizu1_1-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">0.516129017</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
