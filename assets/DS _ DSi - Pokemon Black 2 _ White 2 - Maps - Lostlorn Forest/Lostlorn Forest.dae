  <library_effects>
    <effect id="grass01ax-fx" name="grass01ax">
      <profile_COMMON>
        <newparam sid="grass01ax-diffuse-surface">
          <surface type="2D">
            <init_from>grass01ax-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="grass01ax-diffuse-sampler">
          <sampler2D>
            <source>grass01ax-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="grass01ax-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
