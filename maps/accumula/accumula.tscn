[node name="Objects" type="Node3D" parent="."]

[node name="Gardien" type="Node3D" parent="Objects"]
script = ExtResource("18")
cell = Vector2i(-17, -9)
display_name = "Gardien"
facing = Vector2i(1, 0)
sheet = "ouvrier"
wander_radius = 0
looks_around = false
lines = PackedStringArray("Halte ! Ce passage mène aux terres sauvages.", "Je peux t'y conduire : lagune, volcan, forêt, jungle, désert, montagne ou cimetière.", "Chaque fois, la zone change. Tu pourras lancer 20 Poké Balls au plus, et des dresseurs t'attendront là-bas.")

[node name="Lyra" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(9, 5)
display_name = "Lyra"
sheet = "lyra"
lines = PackedStringArray("Bonjour ! Bienvenue au village.", "Tu as un Pokémon, toi aussi ? Montre-moi ce qu'il sait faire !")
trainer = ExtResource("10")

[node name="Gamin" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(2, 2)
display_name = "Gamin"
sheet = "gamin"
lines = PackedStringArray("Tu as vu la grande estrade sur la place ? Un jour, je ferai un discours dessus !", "Bon, d'abord il faut que j'apprenne à parler devant les gens...")

[node name="Fillette" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(14, 5)
facing = Vector2i(-1, 0)
display_name = "Fillette"
sheet = "fillette"
lines = PackedStringArray("Maman dit que le Centre Pokémon soigne tout le monde.", "Même les dresseurs qui ont un gros chagrin ?")

[node name="EcoliereBlonde" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-4, -8)
display_name = "Écolière"
sheet = "ecoliere_blonde"
lines = PackedStringArray("Ici, la rue monte et descend dans tous les sens.", "Le prof dit que c'est pour ça qu'on a des mollets solides à Accumula !")

[node name="Ecolier" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(4, -7)
facing = Vector2i(1, 0)
display_name = "Écolier"
sheet = "ecolier"
lines = PackedStringArray("Les escaliers de la terrasse, je les monte quatre à quatre.", "Enfin... deux à deux. Ils sont hauts !")

[node name="Lyceenne" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(13, -6)
facing = Vector2i(-1, 0)
display_name = "Lycéenne"
sheet = "lyceenne"
lines = PackedStringArray("D'ici, on voit toute la ville.", "C'est mon coin préféré pour réviser... et pour rêver un peu.")

[node name="GrandPere" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-5, -1)
display_name = "Grand-père"
sheet = "grand_pere"
lines = PackedStringArray("Ah, ce parc ! J'y viens chaque matin depuis quarante ans.", "Les bancs ont changé, les arbres aussi. Pas moi !")

[node name="GrandMere" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-2, 2)
facing = Vector2i(-1, 0)
display_name = "Grand-mère"
sheet = "grand_mere"
lines = PackedStringArray("Tu as l'air pressé, mon petit.", "Prends le temps de regarder autour de toi : les plus belles aventures commencent souvent à deux pas de chez soi.")

[node name="ChasseurInsectes" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-11, 12)
facing = Vector2i(0, -1)
display_name = "Chasseur d'insectes"
sheet = "chasseur_insectes"
lines = PackedStringArray("Chut ! Il y a peut-être un Pokémon caché dans le lierre.", "... Non. Toujours rien. Je reviendrai demain.")

[node name="Marin" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(15, 9)
facing = Vector2i(-1, 0)
display_name = "Marin"
sheet = "marin"
lines = PackedStringArray("Je suis en escale. Ma prochaine traversée part dans une semaine.", "En attendant, je découvre la terre ferme. Ça tangue moins !")

[node name="Ouvrier" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-6, 8)
facing = Vector2i(1, 0)
display_name = "Ouvrier"
sheet = "ouvrier"
lines = PackedStringArray("On a refait le dallage de la place basse le mois dernier.", "Les gens marchent dessus sans y penser. C'est le plus beau compliment !")

[node name="Gentleman" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(1, 23)
display_name = "Gentleman"
sheet = "gentleman"
lines = PackedStringArray("Bienvenue dans le quartier des Jardins.", "Ici, on salue ses voisins et on ne marche pas sur les massifs, je vous prie.")

[node name="Elegante" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(10, 24)
facing = Vector2i(-1, 0)
display_name = "Élégante"
sheet = "elegante"
lines = PackedStringArray("Cette fontaine a été sculptée par un artiste venu de très loin.", "Le soir, l'eau scintille sous les réverbères. Un vrai spectacle !")

[node name="DameBlanche" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-3, 29)
facing = Vector2i(1, 0)
display_name = "Dame en blanc"
sheet = "dame_blanche"
lines = PackedStringArray("Je prends le thé à la terrasse tous les après-midi.", "La pâtisserie du chef est la meilleure de la région, croyez-moi.")

[node name="HommeAffaires" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(15, 24)
display_name = "Homme d'affaires"
sheet = "homme_affaires"
lines = PackedStringArray("Les affaires vont bien, mais je n'ai jamais le temps de me promener.", "Vous, en revanche, vous semblez en avoir. Profitez-en !")

[node name="Fleuriste" type="Node3D" parent="Objects"]
