cell = Vector2i(6, 31)
facing = Vector2i(0, -1)
display_name = "Fleuriste"
sheet = "fleuriste"
lines = PackedStringArray("Les massifs autour de la place, c'est moi qui les entretiens.", "Les fleurs jaunes près des statues sont mes préférées. Elles sourient au soleil !")

[node name="Rentier" type="Node3D" parent="Objects"]
script = ExtResource("6")
cell = Vector2i(-6, 25)
display_name = "Rentier"
sheet = "rentier"
lines = PackedStringArray("Ce laboratoire, là-haut ? On dit qu'on y étudie les Pokémon de toute la région.", "Moi, je me contente de les admirer depuis mon balcon.")

[node name="DameChignon" type="Node3D" parent="Objects"]
