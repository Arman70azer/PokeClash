    <effect id="in02_kage-fx" name="in02_kage">
      <profile_COMMON>
        <newparam sid="in02_kage-diffuse-surface">
          <surface type="2D">
            <init_from>in02_kage-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="in02_kage-diffuse-sampler">
          <sampler2D>
            <source>in02_kage-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="in02_kage-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">0.290322572</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
