    <effect id="t02michi_a2-fx" name="t02michi_a2">
      <profile_COMMON>
        <newparam sid="t02michi_a2-diffuse-surface">
          <surface type="2D">
            <init_from>t02michi_a2-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="t02michi_a2-diffuse-sampler">
          <sampler2D>
            <source>t02michi_a2-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <constant>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="t02michi_a2-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </constant>
        </technique>
      </profile_COMMON>
    </effect>
